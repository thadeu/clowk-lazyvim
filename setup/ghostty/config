theme = clowk-night

# Personal preference -- change or drop this line.
working-directory = $HOME/code

background-opacity = 0.95
background-blur = true

# Any mouse selection goes straight to the system clipboard, no cmd+c.
#
# `clipboard` and not the `true` default: on macOS `true` means the SELECTION
# clipboard, which macOS does not have, so selections reached nothing. This is
# also half of how you copy out of the cmd+j popup -- tmux does not give the
# mouse to a popup, so shift+drag (which makes Ghostty ignore tmux's grab) is
# the only mouse selection that works in there.
copy-on-select = clipboard

# --- Typography ---
# The Nerd Font variant is not optional: LazyVim's file icons, git signs and
# diagnostics are all Nerd Font glyphs, and plain "JetBrains Mono" renders every
# one of them as a tofu box. `... Mono` is the strictly monospaced cut, which
# keeps the icons single-width so columns stay aligned.
# brew install --cask font-jetbrains-mono-nerd-font
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14
font-thicken = true

# --- Window & Native macOS Integration ---
window-padding-x = 3
window-padding-y = 1

macos-titlebar-style = tabs
# `left`: the LEFT Option key acts as Alt (a modifier), while the RIGHT Option
# key keeps composing accented characters. With `true` both become Alt and
# dead-key accents stop working -- which matters on non-US keyboard layouts.
macos-option-as-alt = left

# --- Mouse & Cursor ---
cursor-style = block
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2.0

# Everything between the two markers below is what setup/install.sh copies into
# an existing Ghostty config. Keep the markers intact.

# >>> clowk-lazyvim keybinds >>>
# --- The quick terminal: the scratch shell that belongs to no project ---
#
# Half of a pair, and the halves are two keys rather than one key with a rule
# behind it. Ghostty has no conditional config anyway: `performable:` only asks
# whether the action itself can run, and nothing lets a running program pick.
# So you pick.
#
#   cmd+shift+j        this. ONE surface for the whole app, created once and
#                      reused, so its cwd freezes at creation and every tab
#                      reaches the same shell. As a scratch pad that is the
#                      point, and `global:` answers even when Ghostty is not
#                      the focused app.
#   cmd+shift+option+j the terminal of the repo in THIS tab, drawn as a bottom
#                      panel by tmux. See the keybind further down.
quick-terminal-position = bottom
quick-terminal-autohide = false
quick-terminal-animation-duration = 0.0

keybind = global:cmd+shift+j=toggle_quick_terminal


# --- Nerd Font icons, drawn bigger ---
#
# The sidebar's activity bar is three icons, and in a Mono Nerd Font they are
# drawn to fit INSIDE one cell, which leaves them small next to the text. The
# glyph size belongs to the terminal -- no editor can scale one -- and this is
# the knob for it: a percentage added to the maximum height of every nerd font
# icon (Ghostty 1.2.0 and later).
#
# It applies to every icon, so the file icons in the file tree grow with it.
# Tune the number to taste; it needs a config reload (cmd+shift+,) or a new
# window, since the font is set up when a surface is created.
adjust-icon-height = 150%

# If that is not enough, the reason is usually the OTHER axis. In a Nerd Font
# *Mono* build every icon is squeezed to fit the WIDTH of one cell, so there is
# no height left to give it. The fix is to draw the icons -- and only the icons
# -- from the non-Mono build of the same family, where they are cut at full
# width.
#
# Machine-specific, so it ships commented out: run `ghostty +list-fonts` and
# put the non-Mono family you actually have on the right-hand side. On the
# machine this was written on that is `MesloLGS NF` (the powerlevel10k build).
#
# The gap in the middle is deliberate: U+E0A0-U+E0D7 is Powerline, whose
# separators are drawn to fill a cell edge to edge. From a non-Mono font they
# stop lining up and the statusline grows seams.
#
# font-codepoint-map = U+E000-U+E09F=MesloLGS NF
# font-codepoint-map = U+E0D8-U+F8FF=MesloLGS NF
# font-codepoint-map = U+F0000-U+FFFFD=MesloLGS NF
# --- Keybinds: forward VSCode's cmd+ shortcuts to Neovim ---
# `esc:X` sends ESC+X, which Neovim reads as <M-X>.
#
# WARNING: Ghostty does NOT support end-of-line comments. On an `esc:` action the
# comment text would be sent along with the key, and `ghostty +validate-config`
# would still exit 0 because `esc:` accepts arbitrary text. Always keep comments
# on their own line.
#
# Note: these bindings apply to all of Ghostty, not only when Neovim is focused.
# In a plain shell they just send the sequence to the shell (harmless).
#
# super+j = toggle the floating terminal.
#
# Forwarded to Neovim rather than bound to Ghostty's own `toggle_quick_terminal`,
# which was tried and rejected: the quick terminal is a single surface for the
# whole app, created once and reused, so its cwd is frozen at creation instead
# of following the project, and it answers the key from any Ghostty window.
keybind = super+j=esc:j

# super+alt+shift+j = the terminal of THIS repo, drawn as a bottom panel.
#
# The other half of the pair described up at the quick terminal. Ghostty cannot
# draw this one itself: `toggle_quick_terminal` takes no command, so nothing can
# start a per-repo tmux session in it, and its single surface is shared by every
# tab. So the shape is rebuilt in tmux, where the session name comes from the
# pane's cwd. Geometry lives in ~/.tmux.conf under M-J.
#
# Same session as super+j, so those two are two shapes of one terminal and
# either hides it. Only tabs running tmux answer -- `nvim` starts one (see
# ~/.zshrc); in a plain shell tab the key does nothing, and cmd+shift+j is the
# terminal to reach for there.
#
# Bound on BOTH the unicode trigger and the physical key, the same way
# super+alt+b is bound in this file: holding option makes macOS produce a
# different character, so the `super+alt+shift+j` trigger alone can miss, while
# `key_j` matches the physical key whatever it produced.
keybind = super+alt+shift+j=esc:J
keybind = super+alt+shift+key_j=esc:J
# super+w = close buffer
keybind = super+w=esc:w
# super+n = new buffer
keybind = super+n=esc:n
# super+| (shift+backslash) = vertical split
keybind = super+shift+backslash=esc:\
# super+1..5 is deliberately NOT forwarded: it stays Ghostty's own tab
# switching. Buffer switching inside Neovim is option+1..9, which needs no
# keybind here -- Ghostty already sends option as Alt.

# super+b = toggle the file explorer
keybind = super+b=esc:b
# super+option+b = Claude Code in a right sidebar.
#
# Bound on BOTH the unicode trigger and the physical key, the same way cmd+1
# needed once. Holding option makes macOS produce a different character for the
# key -- option+b is the integral sign -- so a `super+alt+b` trigger alone can
# miss, while `key_b` matches the physical key whatever it produced.
keybind = super+alt+b=esc:B
keybind = super+alt+key_b=esc:B
# super+p = find file
keybind = super+p=esc:p
# super+f = grep the project
keybind = super+f=esc:f
# super+z = undo
keybind = super+z=esc:z
# super+shift+z = redo
keybind = super+shift+z=esc:Z
# super+/ = toggle comment
keybind = super+slash=esc:/
# super+shift+f = find and replace, in the sidebar
keybind = super+shift+f=esc:F
# super+shift+g = source control (the changed files), in the sidebar
keybind = super+shift+g=esc:G
# super+c = copy to the system clipboard
keybind = super+c=esc:c
# super+x = cut to the system clipboard
keybind = super+x=esc:x

# --- option+arrow / option+delete ---
# These MUST be bound. Ghostty ships `alt+arrow_left=esc:b` and
# `alt+arrow_right=esc:f` by default, which here would collide head-on with
# super+b (explorer) and super+f (grep) -- option+left would open the file tree.
#
# Every sequence below was verified by feeding the raw bytes to Neovim in a pty
# and reading back the key it resolved to.
#
# The unshifted pair goes as alt+arrow (<M-Left>), NOT as ctrl+arrow: LazyVim
# binds <C-Left> / <C-Right> to shrink and grow the window, so option+left would
# resize the split instead of moving the cursor.
#
# option+left / option+right = previous / next word
keybind = alt+arrow_left=text:\x1b[1;3D
keybind = alt+arrow_right=text:\x1b[1;3C
# option+shift+left / option+shift+right = select the previous / next word.
# ctrl+shift+arrow IS free, and Vim answers it natively once `keymodel` is set
# (see lua/config/options.lua) -- word-wise motion that starts a selection.
keybind = alt+shift+arrow_left=text:\x1b[1;6D
keybind = alt+shift+arrow_right=text:\x1b[1;6C
# option+up / option+down = move the line up / down
keybind = alt+arrow_up=text:\x1b[1;3A
keybind = alt+arrow_down=text:\x1b[1;3B
# option+delete = delete the previous word.
# \x17 is ^W, which already means exactly that in Neovim's insert and command
# modes AND in the shell, so nothing has to be mapped on either side.
keybind = alt+backspace=text:\x17

# --- cmd+arrow: start and end of line ---
# Terminals have no way to transmit cmd, so unlike option these send nothing at
# all without a keybind. `text:` writes the raw escape sequence.
#
# They are forwarded as Home / End rather than through the `esc:` convention
# used above, because that is what these keys MEAN: Neovim already moves to the
# start and end of the line for them, and so does a plain shell. The shifted
# pair selects instead of moving -- see `keymodel` in lua/config/options.lua.
#
# super+left = start of line
keybind = super+left=text:\x1b[H
# super+right = end of line
keybind = super+right=text:\x1b[F
# super+shift+left = select to start of line
keybind = super+shift+left=text:\x1b[1;2H
# super+shift+right = select to end of line
keybind = super+shift+right=text:\x1b[1;2F

# super+v is NOT forwarded on purpose: Ghostty's own paste_from_clipboard
# already reaches Neovim through bracketed paste (normal mode included) and
# keeps working in a plain shell, which `esc:v` would break.

# --- Ghostty's own actions, moved out of the way (one key, one owner) ---
# was super+w
keybind = super+shift+w=close_surface
# was super+n
keybind = super+shift+n=new_window
# was super+c. Ghostty copies the TERMINAL selection, which is not Neovim's
# visual selection -- hence super+c going to Neovim instead. `copy-on-select`
# above already puts any mouse selection on the clipboard, so this is a
# fallback more than a daily key.
keybind = super+shift+c=copy_to_clipboard
# <<< clowk-lazyvim keybinds <<<
